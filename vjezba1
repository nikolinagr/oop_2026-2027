#include <iostream>
using namespace std;
typedef  struct Fraction{
	int numerator, denominator;
	void reduce() {
		int veci, djelitelj;
		if (numerator >= denominator) {
			veci = numerator;
		}
		else {
			veci = denominator;
		}
		for (int i=0; i < veci; i--) {
			if (numerator % veci == 0 && denominator % veci == 0) {
				djelitelj = i;
			}
		}
		cout << djelitelj;
	}
	double value(int numerator, int denominator) {
		return (double)numerator / denominator;
	}
	void print(int numerator, int denominator) {
		cout << numerator << "/" << denominator;
	};
}a,b;

Fraction sum(const Fraction& a, const Fraction& b) {
	Fraction nom{ a.numerator + b.denominator + b.numerator + a.denominator , a.denominator + b.denominator };
	nom.reduce();
	return nom;
}
int main() {
	Fraction a{ 4,7 };
	Fraction b{ 5,6 };
	sum(a, b);
}
