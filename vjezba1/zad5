#include <iostream>
#include <cmath>
using namespace std;

struct Point {
    double x, y;
};

void move_by(Point* p, double dx, double dy) {
    p->x += dx;
    p->y += dy;
}

double dist(const Point* a, const Point* b) {
    return sqrt((a->x - b->x) * (a->x - b->x) +
                (a->y - b->y) * (a->y - b->y));
}

void move_by_ref(Point& p, double dx, double dy) {
    p.x += dx;
    p.y += dy;
}

double dist_ref(const Point& a, const Point& b) {
    return sqrt((a.x - b.x) * (a.x - b.x) +
                (a.y - b.y) * (a.y - b.y));
}

int main() {
    Point a{3, 4};
    Point b{0, 0};

    move_by(&a, 1, 2);
    cout << dist(&a, &b) << endl;

    move_by_ref(a, -1, -2);
    cout << dist_ref(a, b) << endl;

    Point points[5] = {
        {3, 4},
        {1, 2},
        {-2, 1},
        {5, 5},
        {0.5, 0.5}
    };

    int najbliza = 0;

    for (int i = 1; i < 5; i++) {
        if (dist(&points[i], &b) <
            dist(&points[najbliza], &b)) {
            najbliza = i;
        }
    }

    cout << points[najbliza].x << " "
         << points[najbliza].y << endl;

    return 0;
}
