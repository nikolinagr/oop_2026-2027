#include <iostream>
#include <string>
using namespace std;

int main() {
    int godina;
    string ime;

    cin >> godina;
    cin.ignore();
    getline(cin, ime);

    cout << ime[0] << ".";

    for (int i = 0; i < ime.length(); i++) {
        if (ime[i] == ' ') {
            cout << ime[i + 1] << ".";
        }
    }

    int broj = 0;

    for (char c : ime) {
        if (c != ' ') {
            broj++;
        }
    }

    cout << endl;
    cout << broj << endl;
    cout << 2026 - godina << endl;

    return 0;
}
