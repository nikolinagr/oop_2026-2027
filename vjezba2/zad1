#include <iostream>
#include <string>
#define	MAX(a, b) ((a) > (b) ? (a) : (b))
using namespace std;

inline int my_max(int a, int b) {
	return a > b ? a : b;
}
template<typename T>
T my_max_t(T a, T b) {
	return a > b ? a : b;
}
int main() {
	int a = MAX(3, 5);
	int b = 2 * MAX(3, 5);
	int c = MAX(3, 5) + 1;

	cout << "a=" << a << endl;
	cout << "b=" << b << endl;
	cout << "c=" << c << endl;

	cout << endl;

	int i = 3;

	int rezultat = MAX(++i, 2);
	cout << rezultat << endl;
	cout << i << endl;

	i = 3;
	int rezultat2 = my_max(++i, 2);
	cout << rezultat2 << endl;
	cout << i << endl;

	cout << endl;

	cout << my_max_t(3, 5) << endl;
	cout << my_max_t(3.5, 5.3) << endl;
	cout << my_max_t('A', 'B') << endl;
	cout << my_max_t(string("ana"), string("an")) << endl;
	system("pause");
	return 0;
}
